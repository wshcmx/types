{
  "compilerOptions": {
    "module": "Preserve",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strict": true,
    "noLib": true,
    "noEmit": true,
    "typeRoots" : [
      "../lib",
      "../lib/xml"
    ]
  },
  "include": [
    "../lib/**/*.d.ts",
    "../lib/xml/**/*.d.ts",
    "**/*.ts"
  ]
}
